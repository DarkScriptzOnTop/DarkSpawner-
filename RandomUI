-- Notification stack handler
local notifOffset = 0

local function createNotification()
	local usernames = {
		"MasterMaker321", "NoobSlayer55", "CoolDevX", "RainzOT", "PetzLord",
		"SpammerXD", "CloudySnow", "DarkHubber", "FuzzyKitten", "AdminTyper",
		"ZNTBoy", "PetGod123", "Dupify", "iExploit", "SpawnLegend"
	}
	local name = usernames[math.random(1, #usernames)]

	local notif = Instance.new("TextLabel", gui)
	notif.Text = name .. " successfully spawned a Pet"
	notif.Font = Enum.Font.Gotham
	notif.TextScaled = true
	notif.TextColor3 = Color3.new(1, 1, 1)
	notif.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	notif.BorderSizePixel = 0
	notif.Size = UDim2.new(0, 320, 0, 40)
	notif.Position = UDim2.new(1, -340, 1, -60 - notifOffset)
	notif.AnchorPoint = Vector2.new(0, 1)
	notif.BackgroundTransparency = 1
	notif.TextTransparency = 1
	notif.ZIndex = 2

	-- Animate in
	TweenService:Create(notif, TweenInfo.new(0.3), {
		BackgroundTransparency = 0,
		TextTransparency = 0
	}):Play()

	-- Update offset for stacking
	notifOffset = notifOffset + 45

	-- Animate out and remove
	task.delay(2.5, function()
		local tweenOut = TweenService:Create(notif, TweenInfo.new(0.4), {
			BackgroundTransparency = 1,
			TextTransparency = 1
		})
		tweenOut:Play()
		tweenOut.Completed:Wait()
		notif:Destroy()
		notifOffset = notifOffset - 45
	end)
end

-- Button creator
local function createButton(yOffset, bgColor, text)
	local btn = Instance.new("TextButton", frame)
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.Position = UDim2.new(0, 0, 0, yOffset)
	btn.BackgroundColor3 = bgColor
	btn.Font = Enum.Font.GothamBold
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextScaled = true

	btn.MouseButton1Click:Connect(function()
		-- Bounce animation
		local shrink = TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(1, 0, 0, 36)})
		local grow = TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(1, 0, 0, 40)})
		shrink:Play()
		shrink.Completed:Wait()
		grow:Play()

		-- Show notification
		createNotification()
	end)

	return btn
end

