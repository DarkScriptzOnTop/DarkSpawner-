-- Minimize function
local isMinimized = false
minimizeBtn.MouseButton1Click:Connect(function()
	if not isMinimized then
		TweenService:Create(frame, TweenInfo.new(0.3), {Size = UDim2.new(0, 360, 0, 60)}):Play()
		isMinimized = true
	else
		TweenService:Create(frame, TweenInfo.new(0.3), {Size = UDim2.new(0, 360, 0, 280)}):Play()
		isMinimized = false
	end
end)

